# =====================================================================
# KARUNA backend — environment variables
# Copy to .env (gitignored) and fill in.
# =====================================================================

# Database — Postgres in production, SQLite for local dev.
# Render's free Postgres gives you a URL like:
#   postgresql+psycopg://user:pass@host/db
# For local dev you can use: sqlite:///./karuna.db
DATABASE_URL=sqlite:///./karuna.db

# JWT signing key — anything random, 32+ chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Anthropic Claude API key (optional — mock fallback used if missing)
ANTHROPIC_API_KEY=

# CORS — comma-separated origins that may call the API.
# In dev this includes the Vite dev server; add your deployed URL later.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000
